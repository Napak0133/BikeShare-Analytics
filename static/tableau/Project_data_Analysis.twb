            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0hok4os1a8hyyi1cuy96419mwuth].[usr:Calculation_1724641378611232:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0hok4os1a8hyyi1cuy96419mwuth].[usr:Calculation_1724641378717729:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0hok4os1a8hyyi1cuy96419mwuth].[usr:Calculation_1724641378799650:qk]&quot;' />
