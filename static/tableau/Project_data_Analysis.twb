              <range granularity='0.05' max='0.0' min='-0.5' />
            </column>
            <column caption='pTempChange' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Parameter 1724641373995034]' param-domain-type='range' role='measure' type='quantitative' value='-3.0'>
