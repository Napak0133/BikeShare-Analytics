      <column caption="Daily Rentals" datatype="integer" hidden="true" name="[Calculation_0541568050991116]" role="measure" type="quantitative">
        <calculation class="tableau" formula="{ FIXED [dteday] : SUM([Calculation_0807372794646546]) }"/>
      </column>
      <column caption="Rent Selected Year" datatype="integer" name="[Calculation_0807372513513475]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF [Parameters].[Parameter 0807372512468992] = 0 THEN&#13;&#10;    [Calculation_0807372794646546]&#13;&#10;ELSEIF YEAR([dteday]) = [Parameters].[Parameter 0807372512468992] THEN&#13;&#10;    [Calculation_0807372794646546]&#13;&#10;END"/>
      </column>
      <column caption="Rent Change YoY" datatype="real" default-format="*+0.0%;-0.0%;&quot;N/A&quot;" name="[Calculation_0807372515291143]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF ISNULL(SUM([Rent Selected Year (copy)_0807372515119110])) OR SUM([Rent Selected Year (copy)_0807372515119110]) == 0 &#13;&#10;THEN NULL&#13;&#10;ELSE&#13;&#10;    (SUM([Calculation_0807372513513475]) - SUM([Rent Selected Year (copy)_0807372515119110])) / SUM([Rent Selected Year (copy)_0807372515119110])&#13;&#10;END"/>
      </column>
      <column caption="Selected Year" datatype="integer" hidden="true" name="[Calculation_0807372516753418]" role="measure" type="quantitative">
        <calculation class="tableau" formula="[Parameters].[Parameter 0807372512468992]"/>
      </column>
      <column caption="DayType" datatype="string" name="[Calculation_0807372781305872]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [workingday] == 1 THEN&#13;&#10;    &quot;Weekday&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Holliday/Weekend&quot;&#13;&#10;END"/>
      </column>
      <column caption="User Selected Count" datatype="integer" name="[Calculation_0807372794646546]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF CONTAINS(LOWER([Parameters].[Parameter 0807372794392593]), 'casual') THEN&#13;&#10;    [casual]&#13;&#10;ELSEIF CONTAINS(LOWER([Parameters].[Parameter 0807372794392593]), 'registered') THEN&#13;&#10;    [registered]&#13;&#10;ELSE&#13;&#10;    [cnt]&#13;&#10;END"/>
      </column>
      <column caption="Year Filter" datatype="boolean" name="[Calculation_0807372852207635]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[Parameters].[Parameter 0807372512468992] = 0 OR YEAR([dteday]) = [Parameters].[Parameter 0807372512468992]"/>
      </column>
      <column caption="Year Selected" datatype="boolean" name="[Calculation_0807372857446422]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[Parameters].[Parameter 0807372512468992] = 0 OR YEAR([dteday]) = [Parameters].[Parameter 0807372512468992]"/>
      </column>
      <column caption="Casual Card State" datatype="string" name="[Calculation_0807372872556569]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF CONTAINS(LOWER([Parameters].[Parameter 0807372794392593]), 'casual') THEN 'Selected'&#13;&#10;ELSEIF CONTAINS(LOWER([Parameters].[Parameter 0807372794392593]), 'registered') THEN 'Dimmed'&#13;&#10;ELSE 'All'&#13;&#10;END"/>
      </column>
      <column caption="Registered Card State" datatype="string" name="[Calculation_0807372872646682]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF CONTAINS(LOWER([Parameters].[Parameter 0807372794392593]), 'registered') THEN 'Selected'&#13;&#10;ELSEIF CONTAINS(LOWER([Parameters].[Parameter 0807372794392593]), 'casual') THEN 'Dimmed'&#13;&#10;ELSE 'All'&#13;&#10;END"/>
      </column>
      <column caption="casual %" datatype="real" default-format="p0.00%" name="[Calculation_0807373081817122]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([casual]) / SUM([cnt])"/>
      </column>
      <column caption="registered %" datatype="real" default-format="p0.00%" name="[Calculation_0807373082214435]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([registered]) / SUM([cnt])"/>
      </column>
      <column caption="Total Rentals" datatype="integer" name="[Calculation_1724640687730688]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([Calculation_0807372794646546])"/>
      </column>
      <column caption="select metric" datatype="real" name="[Calculation_1724640689000452]" role="measure" type="quantitative">
        <calculation class="tableau" formula="CASE [Parameters].[Parameter 1724640688803843]&#13;&#10;  WHEN 'Total' THEN SUM([Calculation_0807372794646546])&#13;&#10;  WHEN 'Average' THEN AVG([Calculation_2699356400123905]) &#13;&#10;END"/>
      </column>
      <column caption="Fist only" datatype="boolean" hidden="true" name="[Calculation_1724640716472333]" role="measure" type="nominal">
        <calculation class="tableau" formula="FIRST() = 0">
          <table-calc ordering-type="Rows"/>
        </calculation>
      </column>
      <column caption="Baseline Rentals" datatype="real" name="[Calculation_1724641374449692]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF MONTH([dteday]) = [Parameters].[Parameter 1724641372909591] THEN [cnt] END) &#13;&#10;/ &#13;&#10;COUNTD(IF MONTH([dteday]) = [Parameters].[Parameter 1724641372909591] THEN YEAR([dteday]) END)"/>
      </column>
      <column caption="Simulated Rentals" datatype="real" name="[Calculation_1724641374724125]" role="measure" type="quantitative">
        <calculation class="tableau" formula="MAX(&#13;&#10;  0,&#13;&#10;  [Calculation_1724641374449692] * (&#13;&#10;    1 &#13;&#10;    + [Parameters].[Parameter 1724641373773849] &#13;&#10;    + ([Parameters].[Parameter 1724641373995034] * [Parameters].[Parameter 1724641374261275])&#13;&#10;  )&#13;&#10;)"/>
      </column>
      <column caption="Rental Change (%)" datatype="real" name="[Calculation_1724641374830622]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF ISNULL([Calculation_1724641374449692]) OR [Calculation_1724641374449692] = 0 THEN 0&#13;&#10;ELSE ([Calculation_1724641374724125] - [Calculation_1724641374449692]) / [Calculation_1724641374449692]&#13;&#10;END"/>
      </column>
      <column caption="Demand Level" datatype="string" name="[Calculation_1724641375059999]" role="measure" type="nominal">
        <calculation class="tableau" formula="IF [Calculation_1724641374724125] &gt;= ([Calculation_1724641374449692] * 1.15) THEN&#13;&#10;    &quot;สูง (High)&quot;&#13;&#10;ELSEIF [Calculation_1724641374724125] &gt;= ([Calculation_1724641374449692] * 0.85) THEN&#13;&#10;    &quot;ปานกลาง (Medium)&quot;&#13;&#10;ELSE&#13;&#10;    &quot;ต่ำ (Low)&quot;&#13;&#10;END"/>
      </column>
      <column caption="Scenario - Normal" datatype="real" name="[Calculation_1724641378611232]" role="measure" type="quantitative">
        <calculation class="tableau" formula="[Calculation_1724641374449692]"/>
      </column>
      <column caption="Scenario - Rainy" datatype="real" name="[Calculation_1724641378717729]" role="measure" type="quantitative">
        <calculation class="tableau" formula="MAX(0, [Calculation_1724641374449692] * (1 - 0.20))"/>
      </column>
      <column caption="Scenario - Rainy &amp; Cooler" datatype="real" name="[Calculation_1724641378799650]" role="measure" type="quantitative">
        <calculation class="tableau" formula="MAX(&#13;&#10;  0, &#13;&#10;  [Calculation_1724641374449692] * (1 - 0.20 - (3 * [Parameters].[Parameter 1724641374261275]))&#13;&#10;)"/>
      </column>
      <column caption="Date_Filter" datatype="date" hidden="true" name="[Calculation_1724641416110125]" role="measure" type="ordinal">
        <calculation class="tableau" formula="LOOKUP(MIN([dteday]), 0)">
          <table-calc ordering-type="Rows"/>
        </calculation>
      </column>
      <column caption="temp_cal" datatype="real" name="[Calculation_2067411752480769]" role="measure" type="quantitative">
        <calculation class="tableau" formula="[temp] * 41"/>
      </column>
      <column caption="atemp_cal" datatype="real" hidden="true" name="[Calculation_2067411753623554]" role="measure" type="quantitative">
        <calculation class="tableau" formula="[atemp] * 50"/>
      </column>
      <column caption="hum_cal" datatype="real" hidden="true" name="[Calculation_2067411753824259]" role="measure" type="quantitative">
        <calculation class="tableau" formula="[hum] * 100"/>
      </column>
      <column caption="windspeed_cal" datatype="real" hidden="true" name="[Calculation_2067411753906180]" role="measure" type="quantitative">
        <calculation class="tableau" formula="[windspeed] * 67"/>
      </column>
      <column caption="Register_ratio" datatype="real" hidden="true" name="[Calculation_2067411755589638]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([registered]) / SUM([cnt])"/>
      </column>
      <column caption="Casual_ratio" datatype="real" hidden="true" name="[Calculation_2067411756122119]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([casual]) / SUM([cnt])"/>
      </column>
      <column caption="Avg_Hourly_Rentals" datatype="real" hidden="true" name="[Calculation_2067411756376073]" role="measure" type="quantitative">
        <calculation class="tableau" formula="AVG([cnt])"/>
      </column>
      <column caption="Daily Average per Season" datatype="integer" hidden="true" name="[Calculation_2067411759865866]" role="measure" type="quantitative">
        <calculation class="tableau" formula="{ FIXED [season], [dteday] : SUM([cnt]) }"/>
      </column>
      <column caption="Annual_rent_weather" datatype="real" hidden="true" name="[Calculation_2067411761225740]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([cnt]) / SUM({ FIXED [yr] : SUM([cnt]) })"/>
      </column>
      <column caption="Weather Description" datatype="string" name="[Calculation_2067412083130382]" role="dimension" type="nominal">
        <calculation class="tableau" formula="CASE [weathersit]&#13;&#10;WHEN 1 THEN &quot;Clear&quot;&#13;&#10;WHEN 2 THEN &quot;Misty / Cloudy&quot;&#13;&#10;WHEN 3 THEN &quot;Light Rain / Snow&quot;&#13;&#10;WHEN 4 THEN &quot;Heavy Rain / Snow&quot;&#13;&#10;ELSE &quot;Unknown&quot;&#13;&#10;END"/>
      </column>
      <column caption="Rental Check" datatype="integer" hidden="true" name="[Calculation_2699356399882240]" role="measure" type="quantitative">
        <calculation class="tableau" formula="[cnt] - [casual] - [registered]"/>
      </column>
      <column caption="Average Daily Rentals" datatype="integer" name="[Calculation_2699356400123905]" role="measure" type="quantitative">
        <calculation class="tableau" formula="{ INCLUDE [dteday] : SUM([Calculation_0807372794646546]) }"/>
      </column>
      <column caption="Working_Day_Label" datatype="string" name="[Calculation_2699356408131590]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [workingday] = 1 THEN &quot;Working Day&quot;&#13;&#10;ELSE &quot;Non-working Day&quot;&#13;&#10;END"/>
