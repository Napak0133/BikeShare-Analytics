    <dashboard name="Bike Sharing " type="storyboard">
      <repository-location derived-from="http://localhost:9100/t/thanatchanunboonkasem-8b976e5748/workbooks/Project_data_Analysis_17930145091120/BikeSharing?rev=" id="BikeSharing" path="/t/thanatchanunboonkasem-8b976e5748/workbooks/Project_data_Analysis_17930145091120" revision="" site="thanatchanunboonkasem-8b976e5748"/>
      <style/>
      <size maxheight="900" maxwidth="1600" minheight="900" minwidth="1600" preset-index="8" sizing-mode="fixed"/>
      <zones>
        <zone h="100000" id="2" type-v2="layout-basic" w="100000" x="0" y="0">
          <zone h="98222" id="1" param="vert" removable="false" type-v2="layout-flow" w="99000" x="500" y="889">
            <zone h="8778" id="4" paired-zone-id="5" removable="false" type-v2="flipboard-nav" w="99000" x="500" y="889"/>
            <zone h="89444" id="5" paired-zone-id="4" removable="false" type-v2="flipboard" w="99000" x="500" y="9667">
              <flipboard active-id="1" nav-type="arrowonly" show-nav-arrows="true">
                <story-points>
