              <calculation class="tableau" formula="2012"/>
              <aliases>
                <alias key="0" value="ทั้งหมด"/>
              </aliases>
            </column>
            <column alias="registered(สมาชิก)" caption="User Type" datatype="string" name="[Parameter 0807372794392593]" param-domain-type="list" role="measure" type="nominal" value="&quot;Sum of registered&quot;">
              <calculation class="tableau" formula="&quot;Sum of registered&quot;"/>
              <aliases>
                <alias key="&quot;cnt&quot;" value="ทั้งหมด"/>
                <alias key="&quot;Sum of casual&quot;" value="casual(ผู้ใช้ทั่วไป)"/>
                <alias key="&quot;Sum of registered&quot;" value="registered(สมาชิก)"/>
              </aliases>
            </column>
            <column caption="select view" datatype="string" name="[Parameter 1724640688803843]" param-domain-type="list" role="measure" type="nominal" value="&quot;Average&quot;">
              <calculation class="tableau" formula="&quot;Average&quot;"/>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="federated.0hok4os1a8hyyi1cuy96419mwuth">
            <column caption="DayType" datatype="string" name="[Calculation_0807372781305872]" role="dimension" type="nominal">
              <calculation class="tableau" formula="IF [workingday] == 1 THEN&#13;&#10;    &quot;Weekday&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Holliday/Weekend&quot;&#13;&#10;END"/>
            </column>
            <column caption="User Selected Count" datatype="integer" name="[Calculation_0807372794646546]" role="measure" type="quantitative">
              <calculation class="tableau" formula="IF CONTAINS(LOWER([Parameters].[Parameter 0807372794392593]), 'casual') THEN&#13;&#10;    [casual]&#13;&#10;ELSEIF CONTAINS(LOWER([Parameters].[Parameter 0807372794392593]), 'registered') THEN&#13;&#10;    [registered]&#13;&#10;ELSE&#13;&#10;    [cnt]&#13;&#10;END"/>
            </column>
            <column caption="Year Filter" datatype="boolean" name="[Calculation_0807372852207635]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[Parameters].[Parameter 0807372512468992] = 0 OR YEAR([dteday]) = [Parameters].[Parameter 0807372512468992]"/>
            </column>
            <column caption="Total Rentals" datatype="integer" name="[Calculation_1724640687730688]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([Calculation_0807372794646546])"/>
            </column>
            <column caption="select metric" datatype="real" name="[Calculation_1724640689000452]" role="measure" type="quantitative">
              <calculation class="tableau" formula="CASE [Parameters].[Parameter 1724640688803843]&#13;&#10;  WHEN 'Total' THEN SUM([Calculation_0807372794646546])&#13;&#10;  WHEN 'Average' THEN AVG([Calculation_2699356400123905]) &#13;&#10;END"/>
            </column>
            <column caption="Weather Description" datatype="string" name="[Calculation_2067412083130382]" role="dimension" type="nominal">
              <calculation class="tableau" formula="CASE [weathersit]&#13;&#10;WHEN 1 THEN &quot;Clear&quot;&#13;&#10;WHEN 2 THEN &quot;Misty / Cloudy&quot;&#13;&#10;WHEN 3 THEN &quot;Light Rain / Snow&quot;&#13;&#10;WHEN 4 THEN &quot;Heavy Rain / Snow&quot;&#13;&#10;ELSE &quot;Unknown&quot;&#13;&#10;END"/>
            </column>
            <column caption="Average Daily Rentals" datatype="integer" name="[Calculation_2699356400123905]" role="measure" type="quantitative">
              <calculation class="tableau" formula="{ INCLUDE [dteday] : SUM([Calculation_0807372794646546]) }"/>
            </column>
